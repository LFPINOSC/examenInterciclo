# Copiar a .env y completar. NUNCA subir .env a GitHub.
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_transporte
DB_USER=postgres
DB_PASSWORD=CAMBIA_ESTO_POR_TU_CLAVE_DE_POSTGRES
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REEMPLAZA_ESTO_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
# Sólo se usan para crear el primer administrador, no se envían a visitantes.
ADMIN_NOMBRE=Administrador Transporte
ADMIN_EMAIL=admin@transporte.local
ADMIN_PASSWORD=REEMPLAZA_ESTO_POR_UNA_CONTRASENA_SEGURA
