digraph Relacional {
  graph [label="MODELO RELACIONAL · GESTIÓN DE TRANSPORTE",labelloc=t,fontsize=18,fontname="Arial Bold",fontcolor="#15314b",bgcolor="#ffffff",pad="0.5",nodesep="0.7",ranksep="1.4",splines=polyline];
  node [shape=plain,fontname="Arial",fontsize=11];
  edge [color="#3c7cc0",penwidth=1.6,arrowsize=.7];
  usuarios [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3979b8" CELLPADDING="7"><TR><TD BGCOLOR="#255e9c" COLSPAN="2"><FONT COLOR="white"><B>USUARIOS</B></FONT></TD></TR><TR><TD BGCOLOR="#eef4ff">PK</TD><TD ALIGN="LEFT" PORT="id">id_usuario INTEGER</TD></TR><TR><TD></TD><TD ALIGN="LEFT">nombre VARCHAR(100)</TD></TR><TR><TD>UQ</TD><TD ALIGN="LEFT">correo VARCHAR(160)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">password_hash VARCHAR(255)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">rol VARCHAR(12)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">activo BOOLEAN</TD></TR><TR><TD></TD><TD ALIGN="LEFT">creado_en TIMESTAMPTZ</TD></TR></TABLE>>];
  vehiculos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3979b8" CELLPADDING="7"><TR><TD BGCOLOR="#255e9c" COLSPAN="2"><FONT COLOR="white"><B>VEHÍCULOS</B></FONT></TD></TR><TR><TD BGCOLOR="#eef4ff">PK</TD><TD ALIGN="LEFT" PORT="id">id_vehiculo INTEGER</TD></TR><TR><TD>UQ</TD><TD ALIGN="LEFT">placa VARCHAR(12)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">marca VARCHAR(60)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">modelo VARCHAR(60)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">capacidad INTEGER</TD></TR><TR><TD></TD><TD ALIGN="LEFT">estado VARCHAR(12)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">creado_en TIMESTAMPTZ</TD></TR></TABLE>>];
  conductores [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3979b8" CELLPADDING="7"><TR><TD BGCOLOR="#255e9c" COLSPAN="2"><FONT COLOR="white"><B>CONDUCTORES</B></FONT></TD></TR><TR><TD BGCOLOR="#eef4ff">PK</TD><TD ALIGN="LEFT" PORT="id">id_conductor INTEGER</TD></TR><TR><TD></TD><TD ALIGN="LEFT">nombres VARCHAR(120)</TD></TR><TR><TD>UQ</TD><TD ALIGN="LEFT">licencia VARCHAR(30)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">telefono VARCHAR(20)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">estado VARCHAR(12)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">creado_en TIMESTAMPTZ</TD></TR></TABLE>>];
  rutas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3979b8" CELLPADDING="7"><TR><TD BGCOLOR="#255e9c" COLSPAN="2"><FONT COLOR="white"><B>RUTAS</B></FONT></TD></TR><TR><TD BGCOLOR="#eef4ff">PK</TD><TD ALIGN="LEFT" PORT="id">id_ruta INTEGER</TD></TR><TR><TD>UQ</TD><TD ALIGN="LEFT">origen + destino</TD></TR><TR><TD></TD><TD ALIGN="LEFT">distancia_km NUMERIC(9,2)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">estado VARCHAR(12)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">creado_en TIMESTAMPTZ</TD></TR></TABLE>>];
  viajes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#129672" CELLPADDING="7"><TR><TD BGCOLOR="#128d70" COLSPAN="2"><FONT COLOR="white"><B>VIAJES</B></FONT></TD></TR><TR><TD BGCOLOR="#e7f8f2">PK</TD><TD ALIGN="LEFT">id_viaje INTEGER</TD></TR><TR><TD>FK</TD><TD ALIGN="LEFT" PORT="ve">id_vehiculo INTEGER</TD></TR><TR><TD>FK</TD><TD ALIGN="LEFT" PORT="co">id_conductor INTEGER</TD></TR><TR><TD>FK</TD><TD ALIGN="LEFT" PORT="ru">id_ruta INTEGER</TD></TR><TR><TD>FK</TD><TD ALIGN="LEFT" PORT="us">id_usuario INTEGER</TD></TR><TR><TD></TD><TD ALIGN="LEFT">fecha_salida TIMESTAMPTZ</TD></TR><TR><TD></TD><TD ALIGN="LEFT">fecha_llegada_prevista TIMESTAMPTZ</TD></TR><TR><TD></TD><TD ALIGN="LEFT">estado VARCHAR(15)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">observaciones VARCHAR(250)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">creado_en TIMESTAMPTZ</TD></TR></TABLE>>];
  {rank=same;usuarios;vehiculos;conductores;rutas;}
  usuarios:id:s -> viajes:us:n [label="1:N"];
  vehiculos:id:s -> viajes:ve:n [label="1:N"];
  conductores:id:s -> viajes:co:n [label="1:N"];
  rutas:id:s -> viajes:ru:n [label="1:N"];
}
